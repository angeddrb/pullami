---
import { useTranslations, type Locale } from '../i18n/ui';
import { localizedPath } from '../i18n/routing';
import { products } from '../data/products';
import { findImage } from '../lib/images';

interface Props {
  lang: Locale;
  altPath: string;
}
const { lang, altPath } = Astro.props;
const t = useTranslations(lang);
const home = localizedPath(lang, '/');
const otherLangLabel = lang === 'es' ? 'english' : 'español';
const chile = findImage('logo_chile');
---

<header class="sticky top-0 z-50 bg-dark text-white">
  <div class="relative mx-auto flex h-16 max-w-7xl items-center justify-between px-gutter">
    <a href={home} class="flex items-center" aria-label="Chile">
      {chile ? <img src={chile.src} alt="Chile" class="h-7 w-auto" /> : <span class="text-sm font-medium tracking-wide">Chile</span>}
    </a>

    <a
      href={home}
      class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2"
      aria-label="Pullami — inicio"
    >
      <img src="/logo_pullami.svg" alt="Pullami" class="h-7 w-auto" width="132" height="35" />
    </a>

    <div class="flex items-center gap-5">
      <a href={altPath} class="text-sm lowercase tracking-wide transition hover:text-brand-lime">
        {otherLangLabel}
      </a>
      <button
        id="menu-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="overlay-menu"
        class="transition hover:text-brand-lime"
      >
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="3" y1="7" x2="21" y2="7"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="17" x2="21" y2="17"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<div
  id="overlay-menu"
  class="invisible fixed inset-0 z-[60] bg-dark text-white opacity-0 transition-opacity duration-300"
>
  <div class="flex h-16 items-center justify-end px-gutter">
    <button id="menu-close" aria-label="Cerrar menú" class="transition hover:text-brand-lime">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav class="mx-auto flex max-w-5xl flex-col gap-12 px-gutter pt-[8vh]">
    <div>
      <p class="mb-1 text-sm font-light tracking-wide text-white/45">{t('nav.home')}</p>
      <a href={home} class="text-4xl font-extralight tracking-wide transition hover:text-brand-lime md:text-5xl">
        {t('nav.home.sub')}
      </a>
    </div>

    <div>
      <p class="mb-2 text-sm font-light tracking-wide text-white/45">{t('nav.products')}</p>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-2 text-4xl font-extralight tracking-wide md:text-5xl">
        {
          products.map((p, i) => (
            <>
              {i > 0 && <span class="text-white/25">/</span>}
              <a
                href={localizedPath(lang, `/productos/${p.slug}/`)}
                class="text-white/55 transition hover:text-white"
              >
                {p.name[lang]}
              </a>
            </>
          ))
        }
      </p>
    </div>

    <div>
      <p class="mb-1 text-sm font-light tracking-wide text-white/45">{t('nav.contact')}</p>
      <a
        href={`${home}#contacto`}
        class="text-4xl font-extralight tracking-wide transition hover:text-brand-lime md:text-5xl"
      >
        {t('nav.contact.sub')}
      </a>
    </div>
  </nav>
</div>

<script>
  const wire = () => {
    const toggle = document.getElementById('menu-toggle');
    const close = document.getElementById('menu-close');
    const menu = document.getElementById('overlay-menu');
    if (!toggle || !menu) return;
    const open = (state: boolean) => {
      menu.classList.toggle('invisible', !state);
      menu.classList.toggle('opacity-0', !state);
      toggle.setAttribute('aria-expanded', String(state));
      document.body.style.overflow = state ? 'hidden' : '';
    };
    toggle.addEventListener('click', () => open(true));
    close?.addEventListener('click', () => open(false));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => open(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') open(false);
    });
  };
  wire();
  document.addEventListener('astro:after-swap', wire);
</script>
