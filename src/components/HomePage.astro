---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVideo from './sections/HeroVideo.astro';
import ProductsGrid from './sections/ProductsGrid.astro';
import About from './sections/About.astro';
import QualityControl from './sections/QualityControl.astro';
import ContactSection from './sections/ContactSection.astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  altPath: string;
}
const { lang, altPath } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} altPath={altPath} title="Pullami">
  <h1 class="sr-only">{t('home.srTitle')}</h1>
  <HeroVideo lang={lang} />
  <ProductsGrid lang={lang} />
  <About lang={lang} />
  <QualityControl lang={lang} />
  <ContactSection lang={lang} />
</BaseLayout>
