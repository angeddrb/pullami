---
import { useTranslations, type Locale } from "../i18n/ui";
import ContactDetails from "./ContactDetails.astro";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer id="contacto" class="scroll-mt-16 bg-dark text-white/80">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-10 px-8 py-12 md:flex-row md:items-start md:justify-between"
  >
    <div class="flex flex-col items-start gap-6">
      <img
        src="/logo_pullami.svg"
        alt="Pullami"
        class="h-8 w-auto"
        width="150"
        height="40"
      />
      <button
        data-contact-open
        class="rounded-full border border-white px-8 py-2.5 text-sm font-light tracking-wide text-white transition hover:bg-white hover:text-dark"
      >
        {t("nav.contact.sub")}
      </button>
    </div>

    <div class="grid flex-1 gap-8 sm:grid-cols-3 md:max-w-2xl md:pl-12">
      <ContactDetails lang={lang} variant="footer" />
    </div>
  </div>
</footer>
