---
import type { Locale } from '../../../i18n/ui';
import type { Localized } from '../../../data/types';
import { useTranslations } from '../../../i18n/ui';
import Media from '../../Media.astro';
interface Props {
  intro: Localized;
  items: { name: Localized; detail?: Localized; logo?: string }[];
  lang: Locale;
}
const { intro, items, lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="mx-auto max-w-7xl px-gutter py-16 text-center md:py-24">
  <h2 class="title-rule is-centered text-2xl font-normal tracking-wide md:text-3xl" data-reveal>
    {t('product.certifications')}
  </h2>
  <p class="mx-auto mt-6 max-w-xl text-muted" data-reveal>{intro[lang]}</p>
  <div class="mt-12 grid gap-10 sm:grid-cols-3" data-reveal>
    {items.map((c) => (
      <div class="flex flex-col items-center gap-3">
        <Media name={c.logo ?? c.name[lang]} ratio="1/1" class="w-24" />
        <div>
          <p class="font-semibold">{c.name[lang]}</p>
          {c.detail && <p class="text-xs text-muted">{c.detail[lang]}</p>}
        </div>
      </div>
    ))}
  </div>
</section>
