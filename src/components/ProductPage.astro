---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductHero from './product/ProductHero.astro';
import ProductBlocks from './product/ProductBlocks.astro';
import type { Product } from '../data/types';
import type { Locale } from '../i18n/ui';

interface Props { product: Product; lang: Locale; altPath: string; }
const { product, lang, altPath } = Astro.props;
---
<BaseLayout lang={lang} altPath={altPath} title={`${product.name[lang]} · Pullami`}>
  <ProductHero product={product} lang={lang} />
  <ProductBlocks product={product} lang={lang} />
</BaseLayout>
