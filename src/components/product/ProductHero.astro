---
import type { Product } from '../../data/types';
import { useTranslations, type Locale } from '../../i18n/ui';
import Media from '../Media.astro';
import { findImage } from '../../lib/images';
interface Props { product: Product; lang: Locale; }
const { product, lang } = Astro.props;
const t = useTranslations(lang);
const icon = findImage(product.icon);
const multiSlide = product.slides.length > 1;
---
<section class="relative h-[70svh] w-full overflow-hidden bg-dark">
  <div class="flex h-full snap-x snap-mandatory overflow-x-auto scrollbar-none" data-hero-track>
    {product.slides.map((slide, i) => (
      <div class="relative h-full w-full shrink-0 snap-center">
        <Media
          name={slide}
          alt={product.name[lang]}
          ratio="auto"
          rounded={false}
          widths={[800, 1280, 1920]}
          sizes="100vw"
          class="h-full w-full"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
        />
        <div class="absolute inset-0 bg-black/30"></div>
      </div>
    ))}
  </div>

  <div class="pointer-events-none absolute inset-0 grid place-items-center text-center">
    <div>
      {
        icon ? (
          <img src={icon.src} alt="" class="mx-auto mb-3 h-16 w-16 object-contain" aria-hidden="true" />
        ) : (
          <div class="mx-auto mb-3 grid h-16 w-16 place-items-center rounded-full border border-white/70 text-white/90" aria-hidden="true">
            <span class="text-xs uppercase tracking-wider">icon</span>
          </div>
        )
      }
      <h1 class="text-4xl font-extralight tracking-wide text-white drop-shadow md:text-6xl">{product.name[lang]}</h1>
    </div>
  </div>

  {multiSlide && (
    <div class="absolute bottom-6 left-1/2 flex -translate-x-1/2 gap-2" data-hero-dots>
      {product.slides.map((_, i) => (
        <button
          type="button"
          data-slide={i}
          aria-label={`${t('product.slide')} ${i + 1}`}
          aria-current={i === 0 ? 'true' : undefined}
          class:list={['h-2 w-2 rounded-full transition', i === 0 ? 'bg-white' : 'bg-white/40']}
        />
      ))}
    </div>
  )}
</section>

<script>
  const wire = () => {
    document.querySelectorAll<HTMLElement>('[data-hero-track]').forEach((track) => {
      const dotsWrap = track.parentElement?.querySelector('[data-hero-dots]');
      if (!dotsWrap) return;
      const dots = Array.from(dotsWrap.querySelectorAll<HTMLButtonElement>('button'));
      const slides = Array.from(track.children) as HTMLElement[];

      const setActive = (idx: number) => {
        dots.forEach((d, i) => {
          const on = i === idx;
          d.classList.toggle('bg-white', on);
          d.classList.toggle('bg-white/40', !on);
          if (on) d.setAttribute('aria-current', 'true');
          else d.removeAttribute('aria-current');
        });
      };

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          track.scrollTo({ left: track.clientWidth * i, behavior: 'smooth' });
        });
      });

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) setActive(slides.indexOf(e.target as HTMLElement));
          });
        },
        { root: track, threshold: 0.6 }
      );
      slides.forEach((s) => io.observe(s));
    });
  };
  wire();
  document.addEventListener('astro:after-swap', wire);
</script>
